# Discord Bot Token (Required)
DISCORD_TOKEN=your_discord_bot_token_here

# Spotify API (Optional - for Spotify playlist support)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Role that can always skip songs without a vote (default: DJ)
DJ_ROLE_NAME=DJ

# Watch Together Web Server URL
# For local testing:
# WEB_SERVER_URL=http://localhost:5000
# For production:
WEB_SERVER_URL=https://deeppixel.online

# Web dashboard (served by the bot itself at http://<host>:<port>)
WEB_UI_ENABLED=1
WEB_UI_HOST=0.0.0.0
WEB_UI_PORT=8722
# Set a password to require login on the dashboard (recommended if the port is reachable from outside)
WEB_UI_PASSWORD=
