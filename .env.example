# ==============================================================================
# Required Settings
# ==============================================================================
# Discord Bot Token from Discord Developer Portal
DISCORD_TOKEN=your_discord_bot_token_here

# ==============================================================================
# Feature Toggles (1/true/yes to enable, 0/false/no to disable)
# ==============================================================================
# DJ Booth: two live decks, EQ, FX, sampler, and Auto DJ (/dj command and /dj/ UI)
DJ_ENABLED=1
# Watch Together & ReelsTogether: synced video rooms with chat (/watch, /reels, /watch/)
WATCHTOGETHER_ENABLED=1
# Audio Stems separation: karaoke instrumental and stem isolation
STEMS_ENABLED=1
# Shared Co-Browser: server-side Firefox streamed to WatchTogether rooms
COBROWSER_ENABLED=1
# Web Dashboard: browser-based player control and library
WEB_UI_ENABLED=1
# Autoplay: automatic next-song suggestions and transition planning
AUTOPLAY_ENABLED=1
# Synced and plain lyrics
LYRICS_ENABLED=1
# Huddle self-hosted chat/voice integration
HUDDLE_ENABLED=1

# ==============================================================================
# Web Dashboard & Watch Together Networking
# ==============================================================================
# Public URL for Watch Together invites and reverse proxy routing
# For local testing: WEB_SERVER_URL=http://localhost:8722
WEB_SERVER_URL=https://deeppixel.online

WEB_UI_HOST=0.0.0.0
WEB_UI_PORT=8722
# Required when WEB_UI_HOST is not loopback (127.0.0.1)
WEB_UI_PASSWORD=replace_with_a_long_random_password

# ==============================================================================
# Storage & Paths
# ==============================================================================
# Persistent storage directory (used in Docker; defaults to current dir locally)
# DATA_DIR=/data
# MUSIC_LIBRARY_PATH=/data/musics

# ==============================================================================
# Optional Integrations
# ==============================================================================
# Spotify API (for importing Spotify playlists/albums)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Role allowed to manage/skip songs without a vote (default: DJ)
DJ_ROLE_NAME=DJ

# Optional: YouTube cookies (Netscape cookies.txt) so age-restricted videos play
# YTDLP_COOKIES=/data/youtube-cookies.txt

# Media server auto-refresh (Navidrome / Lidarr)
# NAVIDROME_URL=http://localhost:4533
# NAVIDROME_API_KEY=your_navidrome_api_key
# LIDARR_URL=http://localhost:8686
# LIDARR_API_KEY=your_lidarr_api_key
